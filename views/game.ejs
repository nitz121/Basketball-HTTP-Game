<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Basketball League - HTTP & REST Game</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="topbar">
    <div class="topbar-title">
      <h1>🏀 Basketball League - HTTP & REST Game</h1>
      <p class="subtitle">Practice real HTTP requests against a real server</p>
    </div>
    <nav class="topbar-nav">
      <a href="/schemas">Resource Schemas</a>
    </nav>
  </header>

  <main class="game-container">
    <section class="status-bar">
      <div class="status-item">
        <span class="status-label">Stage</span>
        <span id="stage-counter" class="status-value">-</span>
      </div>
      <div class="status-item">
        <span class="status-label">Score</span>
        <span id="score-value" class="status-value">0</span>
      </div>
      <div class="status-item">
        <span class="status-label">Attempts (current stage)</span>
        <span id="attempts-value" class="status-value">0</span>
      </div>
      <button id="reset-game-btn" class="btn btn-ghost" type="button">Reset Game</button>
    </section>

    <ol id="stage-track" class="stage-track" aria-label="Stage navigation"></ol>

    <section class="stage-card">
      <h2 id="stage-title">Loading...</h2>
      <p id="stage-description" class="stage-description"></p>

      <form id="request-form" class="request-form">
        <div class="form-row">
          <label for="method-select">Method</label>
          <select id="method-select" name="method">
            <option value="GET">GET</option>
            <option value="POST">POST</option>
            <option value="PATCH">PATCH</option>
            <option value="PUT">PUT</option>
            <option value="DELETE">DELETE</option>
          </select>

          <label for="path-input">Request Path</label>
          <input id="path-input" name="path" type="text" placeholder="/api/teams" autocomplete="off" />
        </div>

        <div class="form-block">
          <div class="form-block-header">
            <span>Query Parameters</span>
            <button id="add-query-btn" class="btn btn-small" type="button">+ Add parameter</button>
          </div>
          <div id="query-params-list" class="params-list"></div>
        </div>

        <div class="form-block">
          <div class="form-block-header">
            <span>Request Body (JSON)</span>
          </div>
          <textarea id="body-input" class="body-textarea" rows="5" placeholder='{
  "key": "value"
}'></textarea>
        </div>

        <div class="form-actions">
          <button id="send-btn" class="btn btn-primary" type="submit">Send Request</button>
          <button id="clear-btn" class="btn btn-ghost" type="button">Clear Form</button>
        </div>
      </form>
    </section>

    <section id="response-card" class="response-card hidden">
      <div class="response-header">
        <span id="status-badge" class="status-badge">—</span>
        <span id="verdict-banner" class="verdict-banner"></span>
      </div>
      <p id="verdict-message" class="verdict-message"></p>
      <pre id="response-body" class="response-body"></pre>
      <div class="response-actions">
        <button id="next-stage-btn" class="btn btn-primary hidden" type="button">Next Stage →</button>
      </div>
    </section>
  </main>

  <script>
    // Stage descriptions only (id/order/title/description) - sent from the
    // server at render time. The actual check (what counts as a correct
    // answer) lives only on the server and is not part of this code.
    window.GAME_STAGES = <%- JSON.stringify(stages) %>;
  </script>
  <script src="/js/game.js" defer></script>
</body>
</html>
